{
  "datasets": [
    {
      "name": "18a0f4b5",
      "displayName": "Long Distance Confirmed General Quota Train Bookings Dataset",
      "queryLines": [
        "SELECT\r\n",
        "   rfc.Train_Number,rfc.Class_of_Travel, rfc.Date_of_Journey,rfc.Number_of_Passengers,rfc.Source_Station,rfc.Destination_Station,rfc.Booking_Date\r\n",
        "    \r\n",
        "FROM railway_ticket_confirmation rfc\r\n",
        "WHERE rfc.Quota = 'General'\r\n",
        "  AND rfc.Travel_Distance > 1000 and rfc.Confirmation_Status = 'Confirmed'\r\n",
        "GROUP BY rfc.Date_of_Journey, rfc.Train_Number, rfc.Number_of_Passengers,rfc.Source_Station,rfc.Destination_Station,rfc.Booking_Date,rfc.Class_of_Travel\r\n",
        "ORDER BY rfc.Date_of_Journey;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "21a54070",
      "displayName": "Long Distance Train Journey Booking Records",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "    rfc.Train_Number,\r\n",
        "    rfc.Date_of_Journey,\r\n",
        "    rfc.Booking_Date,\r\n",
        "    rfc.Source_Station,\r\n",
        "    rfc.Destination_Station,\r\n",
        "    rfc.Travel_Distance,\r\n",
        "    rfc.Class_of_Travel,\r\n",
        "    rfc.Age_of_Passengers,\r\n",
        "    rfc.Booking_Channel\r\n",
        "FROM railway_ticket_confirmation rfc\r\n",
        "WHERE year(rfc.Date_of_Journey) BETWEEN 2024 AND year(current_date()) and month(rfc.Date_of_Journey) BETWEEN 1 AND month(current_date())\r\n",
        "  AND rfc.Travel_Distance > 1000\r\n",
        "ORDER BY rfc.Date_of_Journey DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "f68756e4",
      "displayName": "Railway Passenger Traffic Summary Between Medium Distances",
      "queryLines": [
        "SELECT\r\n",
        "DISTINCT\r\n",
        " rtc.Train_Type,\r\n",
        "  rtc.Source_Station,\r\n",
        "  rtc.Destination_Station,\r\n",
        " rtc.Number_of_Stations,\r\n",
        " rtc.Travel_Distance,\r\n",
        "  COUNT(Train_Number) AS trains_count,\r\n",
        "  SUM(Number_of_Passengers) AS total_passengers\r\n",
        "FROM railway_ticket_confirmation rtc\r\n",
        "WHERE rtc.Travel_Distance BETWEEN 500 and 1000\r\n",
        "GROUP BY rtc.Source_Station, rtc.Destination_Station, rtc.Train_Type,rtc.Number_of_Stations,rtc.Travel_Distance\r\n",
        "ORDER BY total_passengers DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "e54d54d0",
      "displayName": "railway passenger flow analysis between medium distances",
      "queryLines": [
        "SELECT\r\n",
        "  Source_Station,\r\n",
        "  Destination_Station,\r\n",
        "  ROUND(SUM(Number_of_Passengers) / AVG(Number_of_Stations), 2) AS passengers_per_station\r\n",
        "FROM railway_ticket_confirmation\r\n",
        "WHERE Travel_Distance BETWEEN 500 AND 1000\r\n",
        "GROUP BY Source_Station, Destination_Station\r\n",
        "ORDER BY passengers_per_station DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "4e310e04",
      "displayName": "Total Railway Passenger Count Summary",
      "queryLines": [
        "SELECT\r\n",
        "  SUM(rtc.Number_of_Passengers) AS total_passengers\r\n",
        "FROM railway_ticket_confirmation rtc\r\n",
        "WHERE rtc.Booking_Date BETWEEN '2024-01-01' AND '2026-12-31'\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "90430c12",
      "displayName": "Unique Train Counts from Railway Ticket Data",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(DISTINCT rtc.Train_Number) AS total_bookings\r\n",
        "FROM railway_ticket_confirmation rtc\r\n",
        "WHERE rtc.Booking_Date BETWEEN '2024-01-01' AND '2026-12-31'"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "d6f7395a",
      "displayName": "average passengers per train journey summary",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(\r\n",
        "    SUM(rtc.Number_of_Passengers) * 1.0 / COUNT(DISTINCT rtc.Train_Number),\r\n",
        "    2\r\n",
        "  ) AS avg_passengers_per_train\r\n",
        "FROM railway_ticket_confirmation rtc\r\n",
        "WHERE rtc.Booking_Date BETWEEN '2024-01-01' AND '2026-12-31'"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "3a688c52",
      "displayName": "Train With Highest Passenger Count Summary",
      "queryLines": [
        "SELECT\r\n",
        "  Train_Number,\r\n",
        "  SUM(Number_of_Passengers) AS total_passengers\r\n",
        "FROM railway_ticket_confirmation\r\n",
        "GROUP BY Train_Number\r\n",
        "ORDER BY total_passengers DESC\r\n",
        "LIMIT 1;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "835a9a49",
      "displayName": "Passenger Share Distribution by Travel Class",
      "queryLines": [
        "SELECT\r\n",
        "  Class_of_Travel,\r\n",
        "  CONCAT(\r\n",
        "    ROUND(\r\n",
        "      SUM(Number_of_Passengers) * 100.0 /\r\n",
        "      SUM(SUM(Number_of_Passengers)) OVER (),\r\n",
        "      2\r\n",
        "    ),\r\n",
        "    '%'\r\n",
        "  ) AS passenger_percentage\r\n",
        "FROM railway_ticket_confirmation\r\n",
        "GROUP BY Class_of_Travel;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "51c1dd96",
      "displayName": "Railway Route Performance and Passenger Demand Summary",
      "queryLines": [
        "WITH route_metrics AS (\r\n",
        "  SELECT\r\n",
        "  Train_Number,\r\n",
        "    Source_Station,\r\n",
        "    Destination_Station,\r\n",
        "    Train_Type,\r\n",
        "    ROUND(AVG(Travel_Distance), 0) AS travel_distance_km,\r\n",
        "    ROUND(AVG(Number_of_Stations), 0) AS number_of_stations,\r\n",
        "    SUM(Number_of_Passengers) AS total_passengers,\r\n",
        "    ROUND(\r\n",
        "      AVG(Travel_Distance) / NULLIF(AVG(Number_of_Stations), 0), 2\r\n",
        "    ) AS efficiency_score  -- distance per station (higher = faster/fewer stops)\r\n",
        "  FROM railway_ticket_confirmation\r\n",
        "  WHERE YEAR(Date_of_Journey) BETWEEN 2024 AND 2025\r\n",
        "  GROUP BY\r\n",
        "  Train_Number,\r\n",
        "    Source_Station,\r\n",
        "    Destination_Station,\r\n",
        "    Train_Type\r\n",
        ")\r\n",
        "\r\n",
        "SELECT *,\r\n",
        "  CASE\r\n",
        "    WHEN efficiency_score >= 50 THEN 'High Demand'\r\n",
        "    ELSE 'Low Demand'\r\n",
        "  END AS efficiency_level\r\n",
        "FROM route_metrics\r\n",
        "ORDER BY efficiency_score DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "7fa81986",
      "displayName": "Passenger Counts by Distance and Booking Channel",
      "queryLines": [
        "SELECT\r\n",
        "  'Distance Band' AS metric_type,\r\n",
        "  CASE\r\n",
        "    WHEN Travel_Distance < 500 THEN '< 500 km'\r\n",
        "    WHEN Travel_Distance BETWEEN 500 AND 1000 THEN '500–1000 km'\r\n",
        "    ELSE '> 1000 km'\r\n",
        "  END AS category,\r\n",
        "  SUM(Number_of_Passengers) AS total_passengers\r\n",
        "FROM railway_ticket_confirmation\r\n",
        "GROUP BY\r\n",
        "  CASE\r\n",
        "    WHEN Travel_Distance < 500 THEN '< 500 km'\r\n",
        "    WHEN Travel_Distance BETWEEN 500 AND 1000 THEN '500–1000 km'\r\n",
        "    ELSE '> 1000 km'\r\n",
        "  END\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT\r\n",
        "  'Booking Channel' AS metric_type,\r\n",
        "  Booking_Channel AS category,\r\n",
        "  SUM(Number_of_Passengers) AS total_passengers\r\n",
        "FROM railway_ticket_confirmation\r\n",
        "GROUP BY Booking_Channel;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "be317b7a",
      "displayName": "Train Schedule Data Overview",
      "queryLines": [
        "WITH train_level_summary AS (\r\n",
        "  SELECT\r\n",
        "    rtc.Train_Number,\r\n",
        "    rtc.Train_Type,\r\n",
        "    rtc.Source_Station,\r\n",
        "    rtc.Destination_Station,\r\n",
        "\r\n",
        "    collect_set(rtc.Class_of_Travel) AS class_of_travel_array,\r\n",
        "\r\n",
        "    COUNT(DISTINCT rtc.PNR_Number) AS total_bookings,\r\n",
        "    SUM(rtc.Number_of_Passengers) AS total_passengers\r\n",
        "  FROM railway_ticket_confirmation rtc\r\n",
        "  WHERE rtc.Booking_Date BETWEEN '2024-01-01' AND '2026-12-31'\r\n",
        "    AND rtc.Confirmation_Status IN ('Confirmed', 'RAC')\r\n",
        "  GROUP BY\r\n",
        "    rtc.Train_Number,\r\n",
        "    rtc.Train_Type,\r\n",
        "    rtc.Source_Station,\r\n",
        "    rtc.Destination_Station\r\n",
        ")\r\n",
        "\r\n",
        "SELECT *\r\n",
        "FROM train_level_summary\r\n",
        "ORDER BY total_passengers DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    },
    {
      "name": "44e6d71d",
      "displayName": "Train Route Performance and Booking Overview",
      "queryLines": [
        "WITH route_metrics AS (\r\n",
        "  SELECT\r\n",
        "    Train_Number,\r\n",
        "    Source_Station,\r\n",
        "    Destination_Station,\r\n",
        "    Train_Type,\r\n",
        "    ROUND(AVG(Travel_Distance), 0) AS travel_distance_km,\r\n",
        "    ROUND(AVG(Number_of_Stations), 0) AS number_of_stations,\r\n",
        "    SUM(Number_of_Passengers) AS total_passengers_route,\r\n",
        "    ROUND(\r\n",
        "      AVG(Travel_Distance) / NULLIF(AVG(Number_of_Stations), 0), 2\r\n",
        "    ) AS efficiency_score\r\n",
        "  FROM railway_ticket_confirmation\r\n",
        "  WHERE YEAR(Date_of_Journey) BETWEEN 2024 AND 2026\r\n",
        "  GROUP BY\r\n",
        "    Train_Number,\r\n",
        "    Source_Station,\r\n",
        "    Destination_Station,\r\n",
        "    Train_Type\r\n",
        "),\r\n",
        "\r\n",
        "train_level_summary AS (\r\n",
        "  SELECT\r\n",
        "    rtc.Train_Number,\r\n",
        "    rtc.Train_Type,\r\n",
        "    rtc.Source_Station,\r\n",
        "    rtc.Destination_Station,\r\n",
        "    collect_set(rtc.Class_of_Travel) AS class_of_travel_array,\r\n",
        "    COUNT(DISTINCT rtc.PNR_Number) AS total_bookings,\r\n",
        "    SUM(rtc.Number_of_Passengers) AS total_passengers_booked\r\n",
        "  FROM railway_ticket_confirmation rtc\r\n",
        "  WHERE rtc.Booking_Date BETWEEN '2024-01-01' AND '2026-12-31'\r\n",
        "    AND rtc.Confirmation_Status IN ('Confirmed', 'RAC')\r\n",
        "  GROUP BY\r\n",
        "    rtc.Train_Number,\r\n",
        "    rtc.Train_Type,\r\n",
        "    rtc.Source_Station,\r\n",
        "    rtc.Destination_Station\r\n",
        ")\r\n",
        "\r\n",
        "SELECT \r\n",
        "  rm.Train_Number,\r\n",
        "  rm.Train_Type,\r\n",
        "  rm.Source_Station,\r\n",
        "  rm.Destination_Station,\r\n",
        "  COALESCE(rm.travel_distance_km, 0) AS travel_distance_km,\r\n",
        "  COALESCE(rm.number_of_stations, 0) AS number_of_stations,\r\n",
        "  COALESCE(rm.total_passengers_route, 0) AS total_passengers_route,\r\n",
        "  COALESCE(rm.efficiency_score, 0) AS efficiency_score,\r\n",
        "  CASE\r\n",
        "    WHEN COALESCE(rm.efficiency_score, 0) >= 50 THEN 'High Demand'\r\n",
        "    ELSE 'Low Demand'\r\n",
        "  END AS efficiency_level,\r\n",
        "  COALESCE(tls.total_bookings, 0) AS total_bookings,\r\n",
        "  COALESCE(tls.total_passengers_booked, 0) AS total_passengers_booked\r\n",
        "FROM route_metrics rm\r\n",
        "LEFT JOIN train_level_summary tls\r\n",
        "  ON rm.Train_Number = tls.Train_Number\r\n",
        "  AND rm.Train_Type = tls.Train_Type\r\n",
        "  AND rm.Source_Station = tls.Source_Station\r\n",
        "  AND rm.Destination_Station = tls.Destination_Station\r\n",
        "ORDER BY rm.efficiency_score DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "railwayticket2024"
    }
  ],
